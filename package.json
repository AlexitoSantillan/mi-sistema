{
  "name": "albeyro-sistema",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-frontend": "cd frontend && npm run build",
    "build-exe": "npm run build-frontend && electron-builder --win"
  },
  "build": {
    "appId": "com.albeyro.sistema",
    "productName": "Albeyro Sistema",
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "frontend/public/Logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "backend/**/*",
      "frontend/dist/**/*",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      }
    ]
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  }
}
